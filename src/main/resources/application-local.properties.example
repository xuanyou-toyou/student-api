# ============================================================
# 本地开发配置模板
#
# 使用方法：
#   1. 把本文件复制一份，改名为 application-local.properties
#   2. 把 username / password 改成你自己的数据库账号密码
#   3. application-local.properties 已被 .gitignore 忽略，不会提交
#
# ⚠️ 本文件里不要填真实密码！
# ============================================================

spring.datasource.url=jdbc:mysql://localhost:3306/student_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=改成你自己的密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

logging.level.demo.studentapi=debug
